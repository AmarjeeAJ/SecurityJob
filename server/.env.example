NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgres://securityjob_user:change_me@localhost:5432/securityjob

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# Session / cookie secrets (generate long random strings for production)
SESSION_SECRET=change_this_to_a_long_random_string
COOKIE_SECRET=change_this_to_a_different_long_random_string

# bcrypt cost factor
PASSWORD_HASH_ROUNDS=12

# File uploads
UPLOAD_DIRECTORY=uploads
MAX_FILE_SIZE=5242880

# Owner seed account (used only by seeds/seed.js)
OWNER_DEFAULT_EMAIL=owner@securityjob.in
OWNER_DEFAULT_PASSWORD=ChangeMe123!

# Tracking (optional — leave blank to disable)
META_PIXEL_ID=
GA_MEASUREMENT_ID=
