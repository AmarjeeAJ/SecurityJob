NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgres://securityjob_user:change_me@localhost:5432/securityjob

# Set to "true" if your Postgres provider requires SSL (most managed hosts do:
# Render, Railway, Heroku, RDS, Supabase). Leave unset/false for local Postgres.
DATABASE_SSL=false

# Max DB connections per Node process. Every PM2/cluster instance opens its own
# pool, so (instances x DB_POOL_MAX) must stay well under Postgres
# max_connections (default 100). e.g. 2 instances x 20 = 40 connections.
DB_POOL_MAX=20

# Max candidate registrations per IP per 15 minutes. Kept generous because
# Indian mobile carriers share public IPs across many subscribers (CGNAT), so
# a tight cap blocks real applicants during an ad campaign.
REGISTRATION_RATE_LIMIT=60

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# Set to "true" only if the frontend and backend are on different domains
# (e.g. frontend on Vercel, backend on Render). Forces the session cookie to
# SameSite=None; Secure so it survives cross-site fetch/XHR calls. Leave false
# when both are under the same domain (a VPS behind one nginx, or same site).
CROSS_SITE_COOKIES=false

# Session / cookie secrets (generate long random strings for production)
SESSION_SECRET=change_this_to_a_long_random_string
COOKIE_SECRET=change_this_to_a_different_long_random_string

# bcrypt cost factor
PASSWORD_HASH_ROUNDS=12

# File uploads
UPLOAD_DIRECTORY=uploads
MAX_FILE_SIZE=5242880

# Owner seed account (used only by seeds/seed.js)
OWNER_DEFAULT_EMAIL=owner@securityjob.in
OWNER_DEFAULT_PASSWORD=ChangeMe123!

# Tracking (optional — leave blank to disable)
META_PIXEL_ID=
GA_MEASUREMENT_ID=

# Meta Conversions API (optional -- server-side CompleteRegistration event.
# Leave any of these blank to skip the send safely; registration itself is
# never affected). No default API version is assumed -- set it explicitly.
META_ACCESS_TOKEN=
META_API_VERSION=
META_TEST_EVENT_CODE=

# Meta Ads Insights sync (optional -- Marketing & Analysis page spend data).
# Reuses META_ACCESS_TOKEN/META_API_VERSION above.
META_AD_ACCOUNT_ID=

# Meta Instant Form leads sync (optional -- native lead forms submitted
# directly on Facebook/Instagram). Reuses META_ACCESS_TOKEN/META_API_VERSION
# above; the token's System User must be granted the leads_retrieval
# permission on this Page in Business Settings.
META_PAGE_ID=

# Spybot Security Services -- a separate, already-live application with its
# own Postgres database. READ-ONLY: used only to report on its client_leads
# table in the Marketing & Analysis page, never to write to it. Optional --
# the Spybot side of the dashboard safely shows "not configured" if blank.
SPYBOT_DATABASE_URL=

# Spybot is a separate Meta Business Portfolio with its own ad account and
# Page, so none of the META_* vars above apply to it. Reuses META_API_VERSION.
SPYBOT_META_ACCESS_TOKEN=
SPYBOT_META_AD_ACCOUNT_ID=
SPYBOT_META_PAGE_ID=
